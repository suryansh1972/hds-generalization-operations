# Copy to .env (never committed) and `set -a; . ./.env; set +a`, or export these in your shell / service manager.
# semgen does not read .env files itself; every value can also be passed explicitly (CLI flags, Settings(...)).

# SNOMED CT RF2 release (licensed; obtain it from your National Release Centre / SNOMED International).
# Either the release root, its Snapshot directory, or Snapshot/Terminology.
SEMGEN_RF2_DIR=/path/to/SnomedCT_InternationalRF2_PRODUCTION_YYYYMMDDTHHMMSSZ

# Cache for the parsed release (default: $XDG_CACHE_HOME/semgen or ~/.cache/semgen).
# SEMGEN_CACHE_DIR=/path/to/cache

# Alternative generalization config (default: the packaged semgen/resources/generalization.yaml).
# SEMGEN_CONFIG=/path/to/generalization.yaml

# Optional evidence sources; when absent the dependent operators block (mayo_unavailable / unit_validation_unavailable).
# SEMGEN_MAYO_DB=/path/to/refrange.sqlite          # must match mayo.sha256 in the config
# SEMGEN_MAYO_TEST_MAP=/path/to/mayo_test_map.csv
# SEMGEN_UCUM_ESSENCE=/path/to/ucum-essence.xml    # must match ucum.sha256 in the config

# Opt-in tests on restricted local data (skipped when unset).
# SEMGEN_MIMIC_BUNDLE=/path/to/mimic_00081_sunflower.json
# SEMGEN_MIMIC_GRAPHS=/path/to/patient_graphs.jsonl.gz
